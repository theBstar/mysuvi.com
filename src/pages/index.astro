---
import Base from '../layouts/Base.astro'
import HeroPhone from '../components/HeroPhone.astro'
import KidScreens from '../components/KidScreens.astro'
import ParentDash from '../components/ParentDash.astro'
import Waitlist from '../components/Waitlist.astro'
import Logo from '../components/Logo.astro'
import { SITE } from '../data/site.mjs'
import { getContent } from '../lib/content.mjs'
import { DEFAULT_LOCALE, LOCALES, homePath } from '../data/locales.mjs'
import { contentLocales } from '../lib/content.mjs'

interface Props { locale?: string }
const { locale = DEFAULT_LOCALE } = Astro.props

const c = getContent(locale)
const {
  hero: HERO, waitlist: WAITLIST, proofPoints: PROOF_POINTS, steps: STEPS,
  kid: KID, parent: PARENT, safety: SAFETY, pricing: PRICING, closer: CLOSER, faq: FAQ,
} = c

// The landing page exists in every locale that has a content file.
const alternates = contentLocales.map((code) => ({ code, path: homePath(code) }))
---
<Base
  title={c.meta?.title ?? SITE.title}
  description={c.meta?.description ?? SITE.description}
  locale={locale}
  alternates={alternates}
>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="hero shell">
    <div class="reveal">
      <p class="hero__badge"><span></span>{WAITLIST.badge}</p>
      <h1 class="hero__h1">{HERO.h1a}<br /><em>{HERO.h1b}</em></h1>
      <p class="hero__sub">{HERO.sub}</p>
      <Waitlist id="hero" />
    </div>
    <HeroPhone />
  </section>

  {/* ── Proof points ─────────────────────────────────────────────────── */}
  <section class="shell proof-wrap" aria-label="Suvi at a glance">
    <dl class="proof">
      {PROOF_POINTS.map((p) => (
        <div class="proof__item reveal--scroll">
          <dt class="proof__stat">{p.stat}</dt>
          <dd class="proof__label">{p.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ── How it works ─────────────────────────────────────────────────── */}
  <section class="section band" id="how">
    <div class="shell">
      <div class="head reveal--scroll">
        <p class="eyebrow">How it works</p>
        <h2 class="h2">A phone that hands over freedom one step at a time.</h2>
      </div>
      <ol class="steps">
        {STEPS.map((s) => (
          <li class="step reveal--scroll">
            <span class="step__n" aria-hidden="true">{s.n}</span>
            <h3 class="step__t">{s.title}</h3>
            <p class="step__b">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── The kid's side ───────────────────────────────────────────────── */}
  <section class="section shell split">
    <div class="reveal--scroll">
      <p class="eyebrow">{KID.eyebrow}</p>
      <h2 class="h2 split__h">{KID.title}</h2>
      <p class="lede split__p">{KID.body}</p>
      <ul class="ticks">
        {KID.points.map((k) => <li>{k}</li>)}
      </ul>
    </div>
    <KidScreens />
  </section>

  {/* ── The parent's side ────────────────────────────────────────────── */}
  <section class="section parents" id="parents">
    <div class="shell">
      <div class="head reveal--scroll">
        <p class="eyebrow parents__eyebrow">{PARENT.eyebrow}</p>
        <h2 class="h2 parents__h">{PARENT.title}</h2>
        <p class="lede parents__p">{PARENT.body}</p>
      </div>
      <ParentDash />
    </div>
  </section>

  {/* ── Safety & privacy ─────────────────────────────────────────────── */}
  <section class="section shell">
    <div class="head reveal--scroll">
      <p class="eyebrow">{SAFETY.eyebrow}</p>
      <h2 class="h2">{SAFETY.title}</h2>
    </div>
    <div class="safety">
      {SAFETY.items.map((s) => (
        <article class="safety__item reveal--scroll">
          <h3 class="safety__t">{s.title}</h3>
          <p class="safety__b">{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ── Pricing ──────────────────────────────────────────────────────── */}
  <section class="section band" id="pricing">
    <div class="shell">
      <div class="pricing__head reveal--scroll">
        <h2 class="h2">{PRICING.title}</h2>
        <p class="lede pricing__lede">{PRICING.body}</p>
        <p class="pricing__platform"><span aria-hidden="true"></span>{SITE.platformNote}</p>
      </div>
      <div class="plans">
        {PRICING.plans.map((pl) => (
          <article class:list={['plan', pl.featured && 'plan--dark', 'reveal--scroll']}>
            <div class="plan__top">
              <h3 class="plan__name">{pl.name}</h3>
              {pl.badge && <span class="plan__badge">{pl.badge}</span>}
            </div>
            <p class="plan__price">
              <span class="plan__amount">{pl.price}</span>
              {pl.per && <span class="plan__per">{pl.per}</span>}
            </p>
            {pl.later && <p class="plan__later">{pl.later}</p>}
            <p class="plan__blurb">{pl.blurb}</p>
            <ul class="plan__features">
              {pl.features.map((f) => <li>{f}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── FAQ ──────────────────────────────────────────────────────────── */}
  <section class="section faq-wrap" id="faq">
    <h2 class="h2 reveal--scroll">Questions parents ask first</h2>
    <div class="faq">
      {FAQ.map((f) => (
        <details class="faq__item">
          <summary><h3 class="faq__q">{f.q}</h3><span class="faq__i" aria-hidden="true">+</span></summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {/* ── Closer ───────────────────────────────────────────────────────── */}
  <section class="closer" id="waitlist">
    <div class="shell closer__in">
      <div class="closer__mark"><Logo size="xl" tone="brand" markOnly animate /></div>
      <h2 class="h2 closer__h">{CLOSER.title}</h2>
      <p class="closer__p">{CLOSER.body}</p>
      <Waitlist tone="purple" id="closer" />
    </div>
  </section>
</Base>

<style>
  .head { max-width: 620px; margin-bottom: 48px; }

  /* Hero */
  .hero { padding-block: clamp(48px, 6vw, 76px) 40px; display: grid; gap: 48px; align-items: center; }
  .hero__badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--brand-tint); border: 1px solid var(--brand-tint-border);
    color: var(--brand-hover); font-size: 12.5px; font-weight: 600; letter-spacing: .3px;
    padding: 6px 13px; border-radius: 999px; margin-bottom: 24px;
  }
  .hero__badge span { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }
  .hero__h1 { font-size: clamp(38px, 6.2vw, 60px); letter-spacing: -1.4px; margin-bottom: 22px; }
  .hero__sub { font-size: clamp(17px, 1.9vw, 19px); line-height: 1.6; color: var(--ink-3); max-width: 490px; margin-bottom: 32px; }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.05fr .95fr; } }

  /* Proof points */
  .proof-wrap { padding-bottom: var(--section-y); }
  .proof {
    display: grid; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .proof__item { padding: 26px 28px 26px 0; }
  .proof__stat {
    font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 34px); font-weight: 400;
    color: var(--brand); letter-spacing: -1px; margin-bottom: 4px;
  }
  .proof__label { font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  @media (min-width: 760px) { .proof { grid-template-columns: repeat(3, 1fr); } }

  /* Steps */
  .steps { display: grid; gap: 22px; list-style: none; }
  .step {
    background: var(--bg); border: 1px solid var(--border-warm); border-radius: var(--r-xl);
    padding: 30px 26px 32px; transition: border-color .2s ease, transform .2s ease;
  }
  .step:hover { border-color: var(--brand-light); transform: translateY(-3px); }
  .step__n {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: var(--r-sm);
    background: var(--brand-tint); color: var(--brand); font-size: 14px; font-weight: 700; margin-bottom: 20px;
  }
  .step__t { font-size: 20px; margin-bottom: 9px; }
  .step__b { font-size: 15px; line-height: 1.62; color: var(--body); }
  @media (min-width: 820px) { .steps { grid-template-columns: repeat(3, 1fr); } }

  /* Split (kid's side) */
  .split { display: grid; gap: 48px; align-items: center; }
  .split__h { margin-bottom: 20px; }
  .split__p { margin-bottom: 28px; }
  .ticks { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .ticks li {
    position: relative; padding-left: 32px; font-size: 15.5px; line-height: 1.55; color: var(--ink-2);
  }
  .ticks li::before {
    content: ''; position: absolute; left: 0; top: 3px;
    width: 20px; height: 20px; border-radius: 50%; background: var(--brand-tint);
  }
  .ticks li::after {
    content: ''; position: absolute; left: 6.5px; top: 9.5px;
    width: 7px; height: 7px; border-radius: 50%; background: var(--brand);
  }
  @media (min-width: 900px) { .split { grid-template-columns: .9fr 1.1fr; gap: 56px; } }

  /* Parents */
  .parents { background: var(--dark); }
  .parents__eyebrow { color: var(--brand-accent); }
  .parents__h { color: var(--on-dark); margin-bottom: 16px; }
  .parents__p { color: var(--muted-cool); }
  .parents .head { margin-bottom: 44px; }

  /* Safety */
  .safety {
    display: grid; gap: 1px; background: var(--border-warm);
    border: 1px solid var(--border-warm); border-radius: var(--r-xl); overflow: hidden;
  }
  .safety__item { background: var(--bg); padding: 30px 28px 34px; }
  .safety__t { font-size: 18px; margin-bottom: 8px; }
  .safety__b { font-size: 15px; line-height: 1.62; color: var(--body); }
  @media (min-width: 760px) { .safety { grid-template-columns: 1fr 1fr; } }

  /* Pricing */
  .pricing__head { text-align: center; max-width: 560px; margin: 0 auto 48px; }
  .pricing__lede { margin-top: 14px; margin-bottom: 18px; color: var(--body); }
  .pricing__platform {
    display: inline-flex; align-items: flex-start; gap: 9px; text-align: left;
    background: var(--bg); border: 1px solid var(--border-warm); border-radius: 999px;
    padding: 8px 16px; font-size: 13.5px; color: var(--body);
  }
  .pricing__platform span {
    width: 6px; height: 6px; border-radius: 50%; background: var(--brand);
    flex-shrink: 0; margin-top: 8px; /* sit on the first line, not the block's centre */
  }
  .plans { display: grid; gap: 20px; align-items: start; max-width: 800px; margin-inline: auto; }
  .plan {
    background: var(--bg); border: 1px solid var(--border-warm);
    border-radius: var(--r-xl); padding: 32px 28px 34px;
  }
  .plan--dark { background: var(--plan-dark); border-color: var(--plan-dark-border); }
  .plan__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .plan__name { font-size: 15px; font-weight: 600; letter-spacing: .2px; }
  .plan--dark .plan__name { color: var(--on-dark); }
  .plan__badge {
    font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase;
    background: var(--brand); color: #fff; padding: 4px 10px; border-radius: 999px;
  }
  .plan__price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 6px; }
  .plan__amount {
    font-family: var(--font-display); font-size: 46px; font-weight: 400;
    letter-spacing: -1.5px; color: var(--ink);
  }
  .plan--dark .plan__amount { color: #fff; }
  .plan__per, .plan__later { font-size: 14px; color: var(--muted); }
  .plan--dark .plan__per, .plan--dark .plan__later { color: var(--muted-cool); }
  .plan__later { margin-bottom: 12px; font-size: 13px; }
  .plan__blurb {
    font-size: 14px; line-height: 1.55; color: var(--muted);
    margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--border-warm);
  }
  .plan--dark .plan__blurb { color: var(--muted-cool); border-color: var(--plan-dark-border); }
  .plan__features { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .plan__features li {
    position: relative; padding-left: 20px; font-size: 14.5px; line-height: 1.5; color: var(--ink-2);
  }
  .plan__features li::before {
    content: '·'; position: absolute; left: 6px; top: -1px;
    color: var(--brand); font-weight: 700;
  }
  .plan--dark .plan__features li { color: var(--plan-dark-text); }
  .plan--dark .plan__features li::before { color: var(--brand-accent); }
  @media (min-width: 720px) { .plans { grid-template-columns: 1fr 1fr; } }

  /* FAQ — native <details>, so answers are in the DOM with no JS. */
  .faq-wrap { max-width: 820px; margin-inline: auto; padding-inline: var(--gutter); }
  .faq-wrap > .h2 { margin-bottom: 36px; }
  .faq { border-top: 1px solid var(--border-warm); }
  .faq__item { border-bottom: 1px solid var(--border-warm); }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 22px 4px; cursor: pointer; list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover .faq__q { color: var(--brand); }
  .faq__q { font-size: 17.5px; font-weight: 500; letter-spacing: -.2px; }
  .faq__i {
    font-size: 22px; color: var(--brand); line-height: 1; flex-shrink: 0;
    transition: transform .25s ease;
  }
  .faq__item[open] .faq__i { transform: rotate(45deg); }
  .faq__a { font-size: 16px; line-height: 1.68; color: var(--body); padding: 0 60px 24px 4px; }

  /* Closer */
  .closer { background: var(--brand); padding-block: 88px; }
  .closer__in { max-width: 720px; text-align: center; }
  .closer__mark { display: flex; justify-content: center; margin-bottom: 24px; }
  .closer__h { color: #fff; font-size: clamp(32px, 4.6vw, 44px); letter-spacing: -1.2px; margin-bottom: 16px; }
  .closer__p { font-size: 18px; line-height: 1.6; color: var(--brand-tint-border); margin-bottom: 32px; }
</style>
