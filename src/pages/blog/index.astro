---
import Base from '../../layouts/Base.astro'
import PostList from '../../components/PostList.astro'
import LangSwitch from '../../components/LangSwitch.astro'
import { SITE } from '../../data/site.mjs'
import { DEFAULT_LOCALE, LOCALES, blogPath } from '../../data/locales.mjs'
import { postsIn, localesWithPosts } from '../../lib/blog.mjs'

const posts = await postsIn(DEFAULT_LOCALE)

// The listing exists in every locale, so it carries its own hreflang cluster.
const alternates = (await localesWithPosts()).map((code) => ({ code, path: blogPath(code) }))
---
<Base
  title={`Digital parenting, without the panic — ${SITE.name}`}
  description="Practical writing on first phones, screen time, online safety and digital literacy — for parents deciding what to hand over and when."
  locale={DEFAULT_LOCALE}
  alternates={alternates}
>
  <PostList posts={posts} locale={DEFAULT_LOCALE} />
  <div class="shell" style="max-width:860px;padding-bottom:48px">
    <LangSwitch locale={DEFAULT_LOCALE} alternates={alternates} />
  </div>
</Base>
