---
import Base from '../../layouts/Base.astro'
import Article from '../../components/Article.astro'
import { SITE } from '../../data/site.mjs'
import { DEFAULT_LOCALE } from '../../data/locales.mjs'
import { postsIn, translationIndex, alternatesFor, articleJsonLd } from '../../lib/blog.mjs'

export async function getStaticPaths() {
  const posts = await postsIn(DEFAULT_LOCALE)
  const index = await translationIndex()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, alternates: alternatesFor(index, post.id) },
  }))
}

const { post, alternates } = Astro.props
const jsonLd = articleJsonLd(post, DEFAULT_LOCALE, post.id)
---
<Base
  title={`${post.data.title} — ${SITE.name}`}
  description={post.data.description}
  locale={DEFAULT_LOCALE}
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Article post={post} locale={DEFAULT_LOCALE} alternates={alternates} />
</Base>
