---
import Logo from './Logo.astro'
import { SITE, SOCIAL } from '../data/site.mjs'
import { getContent } from '../lib/content.mjs'
import { localeFromPath } from '../data/locales.mjs'
const c = getContent(localeFromPath(Astro.url.pathname))
const year = new Date().getFullYear()

const ICONS = {
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z',
  Instagram: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.98c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17-.21-.55-.47-.94-.88-1.35-.41-.41-.8-.67-1.35-.88-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.59-.07-4.74-.07Zm0 3.37a4.49 4.49 0 1 1 0 8.98 4.49 4.49 0 0 1 0-8.98Zm0 7.4a2.91 2.91 0 1 0 0-5.82 2.91 2.91 0 0 0 0 5.82Zm5.72-7.6a1.05 1.05 0 1 1-2.1 0 1.05 1.05 0 0 1 2.1 0Z',
  X: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
}
---
<footer class="ft">
  <div class="shell ft__in">
    <Logo size="sm" />

    <nav class="ft__links" aria-label={c.ui.footerNav}>
      {c.ui.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <ul class="ft__social">
      {SOCIAL.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={`${SITE.name} on ${s.label}`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={ICONS[s.label]} />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="ft__c">© {year} {SITE.legalName}</p>
  </div>
</footer>

<style>
  .ft { background: var(--bg); padding-block: 40px; }
  .ft__in {
    display: flex; align-items: center; justify-content: space-between;
    gap: 20px 24px; flex-wrap: wrap;
  }
  .ft__links { display: flex; gap: 24px; font-size: 13.5px; flex-wrap: wrap; }
  .ft__links a { color: var(--muted); }
  .ft__links a:hover { color: var(--brand); }

  .ft__social { display: flex; gap: 8px; list-style: none; }
  .ft__social a {
    display: grid; place-items: center; width: 34px; height: 34px;
    border-radius: 50%; color: var(--muted);
    border: 1px solid var(--border);
    transition: color .15s ease, border-color .15s ease, background .15s ease;
  }
  .ft__social a:hover { color: var(--brand); border-color: var(--brand-tint-border); background: var(--brand-tint); }

  .ft__c { font-size: 13px; color: var(--muted-warm-3); }

  /* Keep the row from collapsing into a ragged stack on narrow screens. */
  @media (max-width: 640px) {
    .ft__in { justify-content: flex-start; }
    .ft__c { width: 100%; }
  }
</style>
