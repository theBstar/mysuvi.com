---
import { QUESTIONS as Q } from '../data/site.mjs'
---
<div id="qm" class="qm" hidden>
  <div class="qm__scrim" data-close></div>
  <div class="qm__panel" role="dialog" aria-modal="true" aria-labelledby="qm-title">
    <h2 id="qm-title" class="qm__title">{Q.title}</h2>
    <p class="qm__intro">{Q.intro}</p>

    <form class="qm__form">
      {Q.items.map((q) => (
        <div class="qm__field">
          <label class="qm__label" for={`qm-${q.key}`}>{q.question}</label>
          {q.type === 'select' ? (
            <select id={`qm-${q.key}`} data-q={q.question}>
              <option value="">Prefer not to say</option>
              {q.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : q.type === 'textarea' ? (
            <textarea id={`qm-${q.key}`} rows="3" placeholder={q.placeholder} data-q={q.question}></textarea>
          ) : (
            <input id={`qm-${q.key}`} type="text" placeholder={q.placeholder} data-q={q.question} />
          )}
        </div>
      ))}

      <p class="qm__error" data-error hidden></p>

      <div class="qm__actions">
        <button type="button" class="qm__btn qm__btn--ghost" data-skip>{Q.skipLabel}</button>
        <button type="submit" class="qm__btn qm__btn--primary" data-finish>{Q.submitLabel}</button>
      </div>
    </form>
  </div>
</div>

<script>
  import { WAITLIST } from '../data/site.mjs'
  import { namesFromEmail } from '../lib/names.mjs'

  const root = document.getElementById('qm')
  if (root) {
    const panel = root.querySelector('.qm__panel')
    const form = root.querySelector('.qm__form')
    const errorEl = root.querySelector('[data-error]')
    const finishBtn = root.querySelector('[data-finish]')
    const skipBtn = root.querySelector('[data-skip]')

    let email = ''
    let source = ''
    let busy = false
    let lastFocused = null

    const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])'

    function open(detail) {
      email = detail.email
      source = detail.source
      lastFocused = document.activeElement
      errorEl.hidden = true
      root.hidden = false
      document.body.style.overflow = 'hidden'
      const first = panel.querySelector(FOCUSABLE)
      if (first) first.focus()
    }

    function close() {
      root.hidden = true
      document.body.style.overflow = ''
      if (lastFocused && lastFocused.focus) lastFocused.focus()
    }

    function collect() {
      // Only answered questions are sent; blanks are simply omitted.
      return Array.from(panel.querySelectorAll('[data-q]'))
        .map((el) => ({ question_value: el.dataset.q, answer_value: el.value.trim() }))
        .filter((a) => a.answer_value)
    }

    async function submit(answers) {
      if (busy) return
      busy = true
      finishBtn.disabled = true
      skipBtn.disabled = true
      errorEl.hidden = true

      const { firstName, lastName } = namesFromEmail(email)
      try {
        const res = await fetch(WAITLIST.apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            waitlist_id: WAITLIST.waitlistId,
            referral_link: window.location.href,
            first_name: firstName,
            last_name: lastName,
            // Answers only persist on the CREATE call — a later POST for the
            // same email is idempotent and silently drops them.
            ...(answers.length ? { answers } : {}),
          }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)

        close()
        document.dispatchEvent(new CustomEvent('waitlist:done', { detail: { source } }))
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'waitlist_signup', { method: 'getwaitlist', answered: answers.length })
        }
      } catch (err) {
        errorEl.textContent = WAITLIST.errorNote
        errorEl.hidden = false
      } finally {
        busy = false
        finishBtn.disabled = false
        skipBtn.disabled = false
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); submit(collect()) })
    skipBtn.addEventListener('click', () => submit([]))

    // Dismissing is a skip, never a lost signup: the address is still sent.
    root.querySelector('[data-close]').addEventListener('click', () => submit([]))
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return
      if (e.key === 'Escape') { e.preventDefault(); submit([]) }
      if (e.key === 'Tab') {
        const items = Array.from(panel.querySelectorAll(FOCUSABLE))
        if (!items.length) return
        const first = items[0]
        const last = items[items.length - 1]
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus() }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }
      }
    })

    document.addEventListener('waitlist:ask', (e) => open(e.detail))
  }
</script>

<style>
  .qm { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 20px; }
  .qm[hidden] { display: none; }
  .qm__scrim { position: absolute; inset: 0; background: rgba(15,15,26,.55); backdrop-filter: blur(3px); }
  .qm__panel {
    position: relative; width: 100%; max-width: 480px;
    max-height: calc(100svh - 40px); overflow-y: auto;
    background: var(--bg); border: 1px solid var(--border-warm);
    border-radius: var(--r-xl); padding: clamp(24px, 4vw, 34px);
    box-shadow: 0 30px 80px rgba(24,17,54,.35);
  }
  .qm__title { font-size: clamp(24px, 3.4vw, 30px); }
  .qm__intro { margin-top: 10px; font-size: 14.5px; line-height: 1.6; color: var(--muted); }
  .qm__form { margin-top: 24px; display: flex; flex-direction: column; gap: 18px; }
  .qm__label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 7px; color: var(--ink-2); }
  .qm__field input, .qm__field select, .qm__field textarea {
    width: 100%; border: 1px solid #DDD9D0; background: #fff; color: var(--ink);
    border-radius: var(--r-md); padding: 11px 13px; font-size: 15px; outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .qm__field textarea { resize: vertical; min-height: 76px; }
  .qm__field input:focus, .qm__field select:focus, .qm__field textarea:focus {
    border-color: var(--brand); box-shadow: 0 0 0 3px rgba(124,58,237,.12);
  }
  .qm__error { font-size: 13.5px; color: #B42318; }
  .qm__actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 4px; }
  .qm__btn {
    border: 1px solid transparent; border-radius: 999px; cursor: pointer;
    padding: 11px 24px; font-size: 14.5px; font-weight: 600;
    transition: background .15s ease, border-color .15s ease, color .15s ease;
  }
  .qm__btn:disabled { opacity: .6; cursor: default; }
  .qm__btn--primary { background: var(--brand); color: #fff; }
  .qm__btn--primary:hover:not(:disabled) { background: var(--brand-hover); }
  .qm__btn--ghost { background: transparent; border-color: var(--border-warm); color: var(--ink-2); }
  .qm__btn--ghost:hover:not(:disabled) { border-color: var(--brand); color: var(--brand); }
  @media (max-width: 460px) { .qm__actions { flex-direction: column-reverse; } .qm__btn { width: 100%; } }
</style>
