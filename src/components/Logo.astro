---
/**
 * Suvi lockup. Each size reproduces a specific instance from the design —
 * geometry, stroke widths and type metrics are copied, not approximated.
 */
interface Props {
  /** xs = phone status · sm = footer · md = dashboard · lg = nav · xl = closing panel */
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl'
  tone?: 'light' | 'dark' | 'brand'
  markOnly?: boolean
  /** Draw-on animation, as in the nav and closing panel. */
  animate?: boolean
  class?: string
}
const { size = 'md', tone = 'light', markOnly = false, animate = false, class: cls = '' } = Astro.props

const S = {
  xs: { w: 58,  h: 14, s1: 1.8, s2: 1,   cx: 14, cy: 5, r: 1.5, tx: 20, ty: 10, fs: 8,  fw: 400, ls: 0.5,
        p1: 'M2 5C2 5 5 1 8 5C11 9 14 5 14 5',      p2: 'M2 10C2 10 5 7 8 10C11 13 14 10 14 10' },
  sm: { w: 84,  h: 20, s1: 1.9, s2: 1.2, cx: 19, cy: 7, r: 1.9, tx: 26, ty: 14, fs: 14, fw: 400, ls: 1.5,
        p1: 'M3 7C3 7 7 2 11 7C15 12 19 7 19 7',    p2: 'M3 13C3 13 7 9 11 13C15 17 19 13 19 13' },
  md: { w: 94,  h: 20, s1: 2,   s2: 1.2, cx: 19, cy: 7, r: 2,   tx: 26, ty: 14, fs: 15, fw: 300, ls: 1.6,
        p1: 'M3 7C3 7 7 2 11 7C15 12 19 7 19 7',    p2: 'M3 13C3 13 7 9 11 13C15 17 19 13 19 13' },
  lg: { w: 104, h: 26, s1: 2.4, s2: 1.5, cx: 23, cy: 9,  r: 2.6, tx: 32, ty: 17, fs: 18, fw: 300, ls: 2.5,
        p1: 'M3 9C3 9 8 2 13 9C18 16 23 9 23 9',    p2: 'M3 17C3 17 8 12 13 17C18 22 23 17 23 17' },
  // Closing panel: mark only, drawn larger. Second wave is 45% here, not 35%.
  xl: { w: 72,  h: 34, s1: 3,   s2: 1.8, cx: 38, cy: 12, r: 3.4, tx: 0,  ty: 0,  fs: 0,  fw: 300, ls: 0,
        p1: 'M6 12C6 12 14 2 22 12C30 22 38 12 38 12', p2: 'M6 22C6 22 14 14 22 22C30 30 38 22 38 22', w2: 0.45 },
}[size]

// Spec: #A78BFA mark on dark, white on the brand surface, #7C3AED on light.
const stroke = tone === 'dark' ? '#A78BFA' : tone === 'brand' ? '#ffffff' : '#7C3AED'
const dot = tone === 'dark' ? '#C4B5FD' : tone === 'brand' ? '#ffffff' : '#7C3AED'
const word = tone === 'dark' ? '#9CA3AF' : tone === 'brand' ? '#ffffff' : '#111827'
const w = markOnly ? S.cx + S.r + 2 : S.w
---
<svg
  class:list={[cls, animate && 'logo--draw']}
  width={w} height={S.h} viewBox={`0 0 ${w} ${S.h}`}
  role="img" aria-label="Suvi" focusable="false"
>
  <path class="logo__w1" d={S.p1} fill="none" stroke={stroke} stroke-width={S.s1} stroke-linecap="round" />
  <path class="logo__w2" d={S.p2} fill="none" stroke={stroke} stroke-width={S.s2} stroke-linecap="round" opacity={S.w2 ?? 0.35} />
  <circle class="logo__dot" cx={S.cx} cy={S.cy} r={S.r} fill={dot} style={`transform-origin:${S.cx}px ${S.cy}px`} />
  {!markOnly && (
    <text
      x={S.tx} y={S.ty} fill={word}
      font-family="Inter, ui-sans-serif, system-ui, sans-serif"
      font-size={S.fs} font-weight={S.fw} letter-spacing={S.ls}
    >suvi</text>
  )}
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes drawW { from { stroke-dashoffset: 120; } to { stroke-dashoffset: 0; } }
    @keyframes popDot { 0%, 55% { opacity: 0; transform: scale(0); } 75% { opacity: 1; transform: scale(1.25); } 100% { opacity: 1; transform: scale(1); } }
    .logo--draw .logo__w1 { stroke-dasharray: 120; animation: drawW 1.1s ease-out both; }
    .logo--draw .logo__w2 { stroke-dasharray: 120; animation: drawW 1.4s ease-out both; }
    .logo--draw .logo__dot { animation: popDot 1.5s ease-out both; }
  }
</style>
