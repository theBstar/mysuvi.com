---
import { SITE } from '../data/site.mjs'
import { LOCALES, DEFAULT_LOCALE } from '../data/locales.mjs'

interface Props {
  title?: string
  description?: string
  /** Page-specific OG image path, absolute or site-relative. */
  image?: string
  /** Set on pages that should not enter the index (thank-you pages, etc.). */
  noindex?: boolean
  type?: 'website' | 'article'
  /** Locale code for this page. Drives html lang, og:locale and hreflang self-reference. */
  locale?: string
  /**
   * Every locale this page exists in, as `{ code, path }`. Emitted as
   * `hreflang` alternates plus `x-default`. Omit on pages with one version.
   */
  alternates?: { code: string; path: string }[]
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.ogImage,
  noindex = false,
  type = 'website',
  locale = DEFAULT_LOCALE,
  alternates = [],
} = Astro.props

const loc = LOCALES[locale] ?? LOCALES[DEFAULT_LOCALE]

// hreflang must be reciprocal and self-referential: every version lists every
// version including itself, or Google drops the cluster. x-default points at
// the English original, which is the one to serve when no locale matches.
const alts = alternates.map((a) => ({
  hreflang: LOCALES[a.code].hreflang,
  href: new URL(a.path, Astro.site).href,
  isDefault: a.code === DEFAULT_LOCALE,
}))

// Astro.site comes from astro.config.mjs, so canonicals are always absolute
// and always point at the production origin regardless of build host.
//
// Trailing slash is deliberate and must stay. Every page builds to
// `<path>/index.html`, so GitHub Pages serves the directory form and 301s the
// bare form to it. A canonical without the slash therefore points at a redirect
// and disagrees with @astrojs/sitemap, which always emits the slash.
const path = Astro.url.pathname.replace(/\/*$/, '/')
const canonical = new URL(path, Astro.site)
const ogImage = new URL(image, Astro.site)
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={loc.ogLocale} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
{SITE.twitter && <meta name="twitter:creator" content={SITE.twitter} />}

<meta name="theme-color" content={SITE.themeColor} />
<meta name="format-detection" content="telephone=no" />

{alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{alts.filter((a) => a.isDefault).map((a) => <link rel="alternate" hreflang="x-default" href={a.href} />)}

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
