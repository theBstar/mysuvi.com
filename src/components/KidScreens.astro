---
import { getContent } from '../lib/content.mjs'
import { localeFromPath } from '../data/locales.mjs'
const c = getContent(localeFromPath(Astro.url.pathname))
const KID = c.kid
/** The two kid-side screens (Quests / Unlocks). Decorative. */
---
<div class="ks" aria-hidden="true">
  {KID.screens.map((scr) => (
    <div class="ks__phone reveal--scroll">
      <div class="ks__screen">
        <p class="ks__tab">{scr.tab}</p>
        <p class="ks__title">{scr.title}</p>
        {scr.rows.map((r) => (
          <div class="ks__row"><p class="ks__a">{r.a}</p><p class="ks__b">{r.b}</p></div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .ks { display: flex; gap: 18px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .ks__phone {
    width: 186px; height: 378px; background: var(--dark);
    border-radius: 28px; padding: 7px; box-shadow: 0 18px 46px rgba(24,17,54,.2);
  }
  .ks__screen {
    width: 100%; height: 100%; background: var(--dark-2);
    border-radius: 22px; padding: 14px 12px; overflow: hidden;
  }
  .ks__tab {
    font-size: 8.5px; letter-spacing: 1.1px; text-transform: uppercase;
    color: var(--muted); margin-bottom: 12px;
  }
  .ks__title { color: #fff; font-size: 15px; font-weight: 600; margin-bottom: 14px; line-height: 1.25; }
  .ks__row { background: var(--dark-3); border-radius: 11px; padding: 11px 12px; margin-bottom: 8px; }
  .ks__a { color: #E5E7EB; font-size: 11px; font-weight: 500; margin-bottom: 3px; }
  .ks__b { color: var(--brand-accent); font-size: 10px; }
</style>
