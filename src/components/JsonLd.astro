---
import { SITE } from '../data/site.mjs'
import { getContent } from '../lib/content.mjs'
import { LOCALES, localeFromPath, homePath } from '../data/locales.mjs'
import { LOCALES } from '../data/locales.mjs'

interface Props {
  /** Locales the site publishes in. Drives the WebSite's inLanguage. */
  locales?: string[]
}
const { locales = ['en'] } = Astro.props

const content = getContent(localeFromPath(Astro.url.pathname))
const FAQ = content.faq
const PRICING = content.pricing

/**
 * The homepage-specific nodes — WebPage, SoftwareApplication, FAQPage — used to
 * render on every page, which meant an article carried a WebPage node
 * describing the homepage and a duplicate FAQPage. Harmless while the site was
 * one language; actively contradictory once a Spanish article asserts an
 * English homepage in its own graph. They now render only where they are true.
 */
const pageLocale = localeFromPath(Astro.url.pathname)
const isHome = Astro.url.pathname.replace(/\/+$/, '/') === homePath(pageLocale)

/**
 * One @graph so entities cross-reference by @id instead of repeating.
 * Suvi ships as software (an Android launcher), so the product entity is a
 * SoftwareApplication, not a physical Product.
 */
const org = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', SITE.url).href },
  ...(SITE.legalName && { legalName: SITE.legalName }),
  ...(SITE.foundingDate && { foundingDate: SITE.foundingDate }),
  ...(SITE.sameAs.length && { sameAs: SITE.sameAs }),
  ...(SITE.contactEmail && {
    contactPoint: {
      '@type': 'ContactPoint',
      email: SITE.contactEmail,
      contactType: 'customer support',
    },
  }),
}

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  publisher: { '@id': org['@id'] },
  inLanguage: locales.map((c) => LOCALES[c].htmlLang),
}

/** Monthly plans get a UnitPriceSpecification so the cadence isn't guessed. */
const toOffer = (pl) => ({
  '@type': 'Offer',
  name: pl.name,
  price: pl.amount,
  priceCurrency: PRICING.currency,
  availability: 'https://schema.org/PreOrder',
  ...(pl.per?.includes('month') && {
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: pl.amount,
      priceCurrency: PRICING.currency,
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
    },
  }),
})

const app = {
  '@type': 'SoftwareApplication',
  '@id': `${SITE.url}/#app`,
  name: SITE.name,
  description: SITE.description,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: 'Parental controls',
  operatingSystem: 'Android',
  publisher: { '@id': org['@id'] },
  // Matches the age range the signup questionnaire actually offers.
  audience: { '@type': 'PeopleAudience', suggestedMinAge: 8, suggestedMaxAge: 16 },
  offers: PRICING.plans.map(toOffer),
}

// Each locale's landing page is its own WebPage. Sharing one `@id` across
// locales would have every translation claim to be the English homepage.
const homeUrl = new URL(homePath(pageLocale), SITE.url).href
const webpage = {
  '@type': 'WebPage',
  '@id': `${homeUrl}#webpage`,
  url: homeUrl,
  name: content.meta?.title ?? SITE.title,
  description: content.meta?.description ?? SITE.description,
  isPartOf: { '@id': website['@id'] },
  about: { '@id': app['@id'] },
  inLanguage: LOCALES[pageLocale].htmlLang,
}


const faq = FAQ.length
  ? [{
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }]
  : []

const graph = {
  '@context': 'https://schema.org',
  '@graph': isHome ? [org, website, webpage, app, ...faq] : [org, website],
}
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
