---
import { ANALYTICS } from '../data/site.mjs'
import { getContent } from '../lib/content.mjs'
import { localeFromPath } from '../data/locales.mjs'

const key = ANALYTICS.consentKey
const c = getContent(localeFromPath(Astro.url.pathname))
const enabled = Boolean(ANALYTICS.gaMeasurementId) && import.meta.env.PROD
---
{enabled && (
  <>
    <div
      id="consent"
      class="cb"
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-t"
      hidden
    >
      <div class="cb__card">
        <p id="consent-t" class="cb__text">
          {c.ui.consent.text}{' '}
          <a class="cb__link" href="/privacy">{c.ui.consent.link}</a>
        </p>
        <div class="cb__actions">
          <button type="button" class="cb__btn cb__btn--ghost" data-decline>{c.ui.consent.decline}</button>
          <button type="button" class="cb__btn cb__btn--primary" data-accept>{c.ui.consent.accept}</button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ key }}>
      (function () {
        var el = document.getElementById('consent')
        if (!el) return

        function read() { try { return localStorage.getItem(key) } catch (e) { return null } }
        function write(v) { try { localStorage.setItem(key, v) } catch (e) { /* ignore */ } }

        var saved = read()
        // 'granted' was already re-applied in the head; 'denied' stands.
        if (saved === 'granted' || saved === 'denied') return

        function choose(value) {
          write(value)
          if (value === 'granted' && window.gtag) {
            window.gtag('consent', 'update', { analytics_storage: 'granted' })
          }
          el.hidden = true
        }

        el.querySelector('[data-accept]').addEventListener('click', function () { choose('granted') })
        el.querySelector('[data-decline]').addEventListener('click', function () { choose('denied') })
        el.hidden = false
      })()
    </script>

    <style>
      .cb {
        position: fixed; inset: auto 0 0 0; z-index: 90;
        padding: 0 var(--gutter) max(var(--gutter), env(safe-area-inset-bottom));
        display: flex; justify-content: center;
      }
      .cb[hidden] { display: none; }
      .cb__card {
        width: 100%; max-width: var(--shell);
        display: flex; align-items: center; gap: 20px 24px; flex-wrap: wrap;
        background: var(--surface); border: 1px solid var(--border-warm);
        border-radius: var(--r-lg); padding: 18px 22px;
        box-shadow: 0 18px 50px rgba(24,17,54,.16);
      }
      .cb__link { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
  .cb__link:hover { color: var(--brand-hover); }
  .cb__text { flex: 1; min-width: 240px; font-size: 14px; line-height: 1.55; color: var(--body); }
      .cb__actions { display: flex; gap: 10px; margin-left: auto; }
      .cb__btn {
        border: 1px solid transparent; border-radius: 999px; cursor: pointer;
        padding: 10px 22px; font-size: 14px; font-weight: 600; white-space: nowrap;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
      }
      .cb__btn--primary { background: var(--brand); color: #fff; }
      .cb__btn--primary:hover { background: var(--brand-hover); }
      .cb__btn--ghost { background: transparent; border-color: var(--border-warm); color: var(--ink-2); }
      .cb__btn--ghost:hover { border-color: var(--brand); color: var(--brand); }
      @media (max-width: 560px) {
        .cb__actions { margin-left: 0; width: 100%; }
        .cb__btn { flex: 1; }
      }
    </style>
  </>
)}
